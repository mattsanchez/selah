{
  "name": "selah",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed:fixture": "tsx scripts/db-seed-fixture.ts",
    "import:bible": "tsx scripts/import-bible.ts",
    "fixture:bible": "tsx scripts/build-bible-fixture.ts",
    "import:study": "tsx scripts/import-study.ts",
    "fixture:study": "tsx scripts/build-study-fixture.ts",
    "e2e:serve": "export AI_PROVIDER=stub && next build && next start --hostname 127.0.0.1 --port ${E2E_PORT:-3000}",
    "e2e": "playwright test",
    "build:boot": "esbuild scripts/boot.ts --bundle --platform=node --format=esm --target=node22 --external:@node-rs/argon2 --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/boot.mjs",
    "first-boot": "tsx scripts/first-boot.ts",
    "e2e:serve:fresh-install": "tsx scripts/e2e-fresh-install.ts serve"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "micromark": "^4.0.3",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
