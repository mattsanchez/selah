# Copy to .env to override. Everything here is optional: a fresh clone, and a
# fresh `docker compose up`, work without a .env file. Never commit your .env.

# --- Self-hosting with `docker compose up` (see "Self-hosting" in the README) ---

# The public address of the site. Set it when the site is reached by a name
# other than localhost. Required for sign-in links by email.
# SELAH_URL=https://selah.example.org

# Where the site is published. The default is this machine only.
# SELAH_PORT=3000
# SELAH_BIND=127.0.0.1

# The install's secret: signs sessions and encrypts saved AI keys. Leave it
# unset to have one generated at first boot and kept in the data volume. If you
# set it: at least 32 random characters (`openssl rand -base64 32`), and never
# change it afterwards.
# SELAH_SECRET=

# The token the setup screen asks for while no owner exists. Leave it unset to
# have one generated at first boot and printed in the app's logs.
# SELAH_SETUP_TOKEN=

# Where first boot downloads the Bible and study files from before it asks
# their publishers. Unset: Selah's data release on GitHub. "off": the
# publishers only. A URL: your own copy of the data release's files.
# SELAH_DATA_MIRROR=off

# Email, for sign-in links. All of SMTP_URL, EMAIL_FROM and SELAH_URL are needed.
# SMTP_URL=smtp://user:password@smtp.example.org:587
# EMAIL_FROM=Selah <selah@example.org>

# AI keys, as an alternative to saving them in Settings. These take precedence.
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# --- Development ---

# Postgres connection used by the app, migrations and the seed scripts. The
# default matches the `db` service in docker-compose.yml.
DATABASE_URL=postgres://selah:selah@127.0.0.1:5432/selah

# Host port docker compose publishes Postgres on. Keep it in step with DATABASE_URL.
SELAH_DB_PORT=5432

# AI provider: "none" (AI features off) or "stub" (deterministic canned output,
# used by tests and `pnpm e2e:serve`). Real providers arrive in later milestones.
AI_PROVIDER=none

# Where the generated secret, the setup token and first-boot downloads are kept
# outside Docker.
# SELAH_DATA_DIR=.data

# EMAIL_TRANSPORT=stub writes emails to <data dir>/outbox instead of sending
# them. For tests.
# EMAIL_TRANSPORT=stub

# SELAH_SEED_TEST_OWNER=1 makes `pnpm db:seed:fixture` also create a test owner
# with a published password. For tests only; never on a real install.

# Ports of the end-to-end servers: E2E_PORT and E2E_PORT + 1.
# E2E_PORT=3000
